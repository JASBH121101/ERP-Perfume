{
  "name": "jb-parfums-erp",
  "version": "0.1.0",
  "private": true,
  "description": "JB PARFUMS ERP — quality and browser test suite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "playwright test",
    "test:unit": "node --test",
    "test:e2e": "playwright test",
    "check:db": "node scripts/check-db-migrations.mjs",
    "check:db:ready": "node scripts/check-db-migrations.mjs --require-ready",
    "migrate:db": "node scripts/migrate-db.mjs --check",
    "migrate:db:apply": "node scripts/migrate-db.mjs --apply",
    "migrate:db:baseline-audit": "node scripts/migrate-db.mjs --reconcile-development-baseline"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "@neondatabase/auth": {
      "better-auth": "1.7.7",
      "@better-auth/core": "1.7.7",
      "@better-auth/oauth-provider": "1.7.7",
      "@better-auth/drizzle-adapter": "1.7.7",
      "@better-auth/kysely-adapter": "1.7.7",
      "@better-auth/memory-adapter": "1.7.7",
      "@better-auth/mongo-adapter": "1.7.7",
      "@better-auth/prisma-adapter": "1.7.7",
      "@better-auth/telemetry": "1.7.7"
    },
    "@react-email/render": "2.2.0",
    "zod": "4.6.6"
  }
}
